#!/usr/bin/env bash
set -euo pipefail

resolve_script_dir() {
  local source_path="${BASH_SOURCE[0]}"
  local source_dir

  while [[ -L "$source_path" ]]; do
    source_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
    source_path="$(readlink "$source_path")"
    if [[ "$source_path" != /* ]]; then
      source_path="$source_dir/$source_path"
    fi
  done

  cd -P "$(dirname "$source_path")" && pwd
}

script_dir="$(resolve_script_dir)"
repo_root="$(cd "$script_dir/.." && pwd)"
continuity_script="$repo_root/skills/continuity/scripts/continuity-state.sh"

[[ -x "$continuity_script" ]] || {
  printf 'andx-continuity: missing executable: %s\n' "$continuity_script" >&2
  exit 1
}

exec "$continuity_script" "$@"
